{
  "tasks": {
    "fetch": "deno run --allow-read --allow-write --allow-net=raw.githubusercontent.com scripts/fetch_sources.ts",
    "build": {
      "command": "deno run --allow-read --allow-write scripts/build.ts",
      "dependencies": [
        "fetch"
      ]
    },
    "test": {
      "command": "deno test --allow-read tests/",
      "dependencies": [
        "fetch"
      ]
    },
    "notes": "deno run --allow-read scripts/release_notes.ts",
    "expected": "deno run --allow-read --allow-write scripts/expected.ts",
    "euc-table": "deno run --allow-write scripts/euc_table.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "include": [
      "scripts/",
      "tests/",
      "deno.json"
    ]
  },
  "lint": {
    "include": [
      "scripts/",
      "tests/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1"
  }
}
